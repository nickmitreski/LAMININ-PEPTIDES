{
  "name": "lamin-storefront",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "images:optimize": "bash scripts/optimize-product-images.sh",
    "build:strip-originals": "vite build && bash scripts/postbuild-strip-originals.sh",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "sitemap": "tsx scripts/write-sitemap.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "supabase": "supabase",
    "functions:serve": "supabase functions serve",
    "functions:deploy": "supabase functions deploy secure-checkout-init --no-verify-jwt",
    "e2e:smoke": "./scripts/e2e-smoke.sh",
    "smoke:secure-checkout": "./scripts/smoke-secure-checkout.sh",
    "verify:coa": "tsx scripts/verify-coa-assets.ts",
    "verify:shop-images": "tsx scripts/verify-shop-images.ts",
    "optimize:supabase-images": "tsx scripts/optimize-supabase-storage-images.ts"
  },
  "dependencies": {
    "@fontsource/instrument-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.57.4",
    "dompurify": "^3.4.12",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.13.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.60.0",
    "@types/dompurify": "^3.0.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "@typescript-eslint/utils": "^8.62.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "dotenv": "^16.4.7",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "happy-dom": "^20.8.9",
    "postcss": "^8.4.35",
    "sharp": "^0.34.5",
    "supabase": "^2.84.8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^5.4.2",
    "vitest": "^2.1.9"
  }
}
